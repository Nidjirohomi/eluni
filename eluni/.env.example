# Скопируйте этот файл в .env.local и заполните реальными значениями.
# cp .env.example .env.local

# Ключ Groq API (https://console.groq.com/keys) — нужен для AI-классификации жалоб.
GROQ_API_KEY=ваш_ключ_от_groq

# Токен Telegram-бота для граждан (создаётся у @BotFather).
# Используется для приёма анонимных обращений через @ElUni_Bot.
TELEGRAM_BOT_TOKEN=ваш_токен_бота_если_есть

# Отдельный Telegram-бот для госслужащих (команда /bind и уведомления).
# Запуск: `npm run gov-bot`. Создайте второго бота у @BotFather.
GOV_TELEGRAM_BOT_TOKEN=токен_второго_бота
# Username gov-бота без @ (для генерации t.me-ссылок в UI).
NEXT_PUBLIC_GOV_BOT_USERNAME=ElUniGovBot

# Ключ 2ГИС MapGL + Catalog/Places API (https://dev.2gis.com).
# Используется на клиенте — поэтому публичный (NEXT_PUBLIC_*).
NEXT_PUBLIC_2GIS_API_KEY=ваш_ключ

# Секрет для подписи JWT-токенов госслужащих. Минимум 16 символов.
JWT_SECRET=любая_секретная_строка_для_подписи_токенов

# Подключение Prisma к локальной SQLite-базе. Менять не нужно.
DATABASE_URL="file:./dev.db"

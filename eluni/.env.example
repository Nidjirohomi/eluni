# Скопируйте этот файл в .env.local и заполните реальными значениями.
# cp .env.example .env.local

# Ключ Groq API (https://console.groq.com/keys) — нужен для AI-классификации жалоб.
GROQ_API_KEY=ваш_ключ_от_groq

# Токен Telegram-бота (создаётся у @BotFather). Можно оставить пустым,
# если интеграция с Telegram не нужна.
TELEGRAM_BOT_TOKEN=ваш_токен_бота_если_есть

# Секрет для подписи JWT-токенов госслужащих. Минимум 16 символов.
JWT_SECRET=любая_секретная_строка_для_подписи_токенов

# Подключение Prisma к локальной SQLite-базе. Менять не нужно.
DATABASE_URL="file:./dev.db"

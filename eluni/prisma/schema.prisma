generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Complaint {
  id             String   @id @default(cuid())
  originalText   String
  officialText   String
  category       String
  priority       String
  assignedTo     String
  assignedUser   String?
  status         String   @default("pending")
  address        String?
  lat            Float?
  lng            Float?
  mediaUrls      String?
  source         String   @default("web")
  telegramUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  role        String
  displayName String
  createdAt   DateTime @default(now())
}
